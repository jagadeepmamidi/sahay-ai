# Sahay AI - Backend Environment Variables
# Copy this to .env and fill in your values

# Groq (Llama 3.3) - required for generated chat answers
GROQ_API_KEY=your-groq-api-key-here
GROQ_CHAT_MODEL=openai/gpt-oss-120b

# Sarvam AI - Indian language STT/TTS
SARVAM_API_KEY=your-sarvam-api-key-here

# CORS (frontend URL)
CORS_ORIGINS=http://localhost:3000

# JWT Auth (CHANGE THIS)
JWT_SECRET_KEY=generate-a-random-secret-key-here

# Optional: Supabase catalog / analytics
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional: Chroma for uploaded PDF supplements only
CHROMA_PERSIST_DIR=./data/chromadb
EMBEDDING_MODEL=intfloat/multilingual-e5-small

# App
DEBUG=true
ENVIRONMENT=development
